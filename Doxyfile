# Doxygen configuration for ESP32 Smart Home

PROJECT_NAME           = "ESP32-S3 Smart Home"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "ESP32-S3 sensor and actuator nodes for Home Assistant"

OUTPUT_DIRECTORY       = doxygen
# ARCHITECTURE.md and ADVANCED_ARCHITECTURE.md were listed here but never
# existed. The architecture write-up lives in docs/architecture.rst, which
# Sphinx renders; ROADMAP.md is included because it is a real root document.
INPUT                  = main \
                         README.md \
                         ROADMAP.md

# *.hpp was missing, so the config structs in Mqtt_cfg.hpp / Wifi_cfg.hpp /
# Uart_cfg.hpp were never scanned -- referencing one from docs failed the
# Sphinx build with "Cannot find class ... in doxygen xml output".
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cpp \
                         *.md

RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES

HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
HTML_STYLESHEET        =

USE_MDFILE_AS_MAINPAGE = README.md

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

QUIET                  = NO
WARNINGS               = YES
WARN_LOGFILE           = docs/doxygen_warnings.log

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO

EXTRACT_ALL            = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

CASE_SENSE_NAMES        = YES
SHORT_NAMES             = NO
JAVADOC_AUTOBRIEF       = YES
QT_AUTOBRIEF            = NO
MULTILINE_CPP_IS_BRIEF  = NO
INHERIT_DOCS            = YES
SEPARATE_MEMBER_PAGES   = NO
TAB_SIZE                = 4
ALIASES                 =

TOC_INCLUDE_HEADINGS   = 0
MARKDOWN_ID_STYLE      = DOXYGEN

MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           =
INCLUDE_FILE_PATTERNS  =
# NOTE: this is the only PREDEFINED line that takes effect -- Doxygen uses the
# last one, so anything set earlier is silently ignored.
#
# __attribute__(x)= strips compiler attributes. ErrorHandler::reportError
# carries __attribute__((format(printf,4,5))); Doxygen copies the raw
# declaration into its XML and Breathe's C++ parser cannot handle it, which
# fails the Sphinx build. The attribute still does its job for the compiler.
PREDEFINED             = ESP_PLATFORM \
                         ESP_IDF_VERSION_MAJOR \
                         ESP_IDF_VERSION_MINOR \
                         __attribute__(x)=

SKIP_FUNCTION_MACROS   = YES

TAGFILES               =
GENERATE_TAGFILE       = docs/smart_home.tag
ALLEXTERNALS           = NO
EXTERNAL_GROUPS        = YES
PERL_PATH              = /usr/bin/perl

CLASS_DIAGRAMS         = YES
MSCGEN_PATH            =
DIA_PATH               =
HIDE_UNDOC_RELATIONS   = YES
HAVE_DOT               = NO
DOT_NUM_THREADS        = 0
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
DOT_FONTPATH           =
CLASS_GRAPH            = YES
COLLABORATION_GRAPH     = YES
GROUP_GRAPHS            = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS      = NO
INCLUDE_GRAPH           = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = png
INTERACTIVE_SVG        = NO

