# Doxygen configuration for ESP32 Smart Home

PROJECT_NAME           = "ESP32 Smart Home"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Production-ready ESP32 smart home firmware"

OUTPUT_DIRECTORY       = docs
INPUT                  = main \
                         README.md \
                         ARCHITECTURE.md \
                         ADVANCED_ARCHITECTURE.md

FILE_PATTERNS          = *.h \
                         *.cpp \
                         *.md

RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES

HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
HTML_STYLESHEET        =

USE_MDFILE_AS_MAINPAGE = README.md

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

QUIET                  = NO
WARNINGS               = YES
WARN_LOGFILE           = docs/doxygen_warnings.log

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO

EXTRACT_ALL            = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

CASE_SENSE_NAMES        = YES
SHORT_NAMES             = NO
JAVADOC_AUTOBRIEF       = YES
QT_AUTOBRIEF            = NO
MULTILINE_CPP_IS_BRIEF  = NO
INHERIT_DOCS            = YES
SEPARATE_MEMBER_PAGES   = NO
TAB_SIZE                = 4
ALIASES                 =

TOC_INCLUDE_HEADINGS   = 0
MARKDOWN_ID_STYLE      = DOXYGEN

MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           =
INCLUDE_FILE_PATTERNS  =
PREDEFINED             = ESP_PLATFORM \
                         ESP_IDF_VERSION_MAJOR \
                         ESP_IDF_VERSION_MINOR

SKIP_FUNCTION_MACROS   = YES

TAGFILES               =
GENERATE_TAGFILE       = docs/smart_home.tag
ALLEXTERNALS           = NO
EXTERNAL_GROUPS        = YES
PERL_PATH              = /usr/bin/perl

CLASS_DIAGRAMS         = YES
MSCGEN_PATH            =
DIA_PATH               =
HIDE_UNDOC_RELATIONS   = YES
HAVE_DOT               = NO
DOT_NUM_THREADS        = 0
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
DOT_FONTPATH           =
